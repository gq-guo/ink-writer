{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ink",
  "version": "0.1.0",
  "identifier": "com.ink.writer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Ink",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "极简 Markdown 写作软件",
    "longDescription": "Ink 是一款本地优先的极简 Markdown 写作软件。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5RUIwRkNERDlCN0ZBMzIKUldReStyZlp6US9yQ1l2N0xKc0tQZkxmRkZ1a3ljWW5rTWFYUlhDeERmWXBTR1ZtYlNKdk5SNWUK",
      "endpoints": [
        "https://github.com/gq-guo/ink-writer/releases/latest/download/latest.json"
      ]
    }
  }
}